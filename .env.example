# Configuración del Servicio de Herramientas PDF
# Copia este archivo a .env para personalizar variables

# Puerto en el host donde escuchará la aplicación
HOST_PORT=8080

# Seguridad y Autenticación Admin
ADMIN_PASSWORD=admin1234
ADMIN_SESSION_HOURS=8
SECRET_KEY=cambiar_esta_clave_por_una_cadena_secreta_aleatoria_en_produccion

# Rendimiento y Concurrencia
MAX_FILE_MB=100
MAX_FILES=20
MAX_CONCURRENT_JOBS=2
GS_TIMEOUT=120
TTL_MINUTES=30

# Privacidad y Métricas en SQLite WAL
LOG_CLIENT_MODE=hash
HASH_SALT=sal_criptografica_unica_para_el_colegio
LOG_RETENTION_DAYS=365

# Redes y Módulos
TRUST_PROXY=true
ADMIN_ALLOWED_NETWORKS=
ENABLED_MODULES=merge,split,rotate,protect,strip_metadata,edit_metadata,img2pdf
